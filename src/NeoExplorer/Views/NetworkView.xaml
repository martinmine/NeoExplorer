<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NeoExplorer.Views.NetworkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NeoExplorer.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="20,12">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}" />

            <StackPanel
                Margin="0,8"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="Searching…" />
            </StackPanel>

            <TextBlock
                Margin="0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />

            <GridView
                x:Name="ItemsGrid"
                AutomationProperties.Name="{x:Bind ViewModel.Heading, Mode=OneWay}"
                DoubleTapped="ItemsGrid_DoubleTapped"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                KeyDown="ItemsGrid_KeyDown">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkItemViewModel">
                        <Grid
                            Width="280"
                            Padding="8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                AutomationProperties.AccessibilityView="Raw"
                                Width="48"
                                Height="48"
                                Source="{x:Bind Icon, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
