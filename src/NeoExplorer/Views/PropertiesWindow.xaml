<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NeoExplorer.Views.PropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NeoExplorer.Services">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Laid out like File Explorer's Properties dialog, without the Advanced... button. -->
    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,10" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <GridLength x:Key="LabelWidth">108</GridLength>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <SelectorBar
            x:Name="Tabs"
            Margin="12,4,12,0"
            SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem
                x:Name="GeneralTab"
                AutomationProperties.AutomationId="GeneralTab"
                IsSelected="True"
                Text="General" />
            <!-- Folders have no Details tab in File Explorer either. -->
            <SelectorBarItem
                x:Name="DetailsTab"
                AutomationProperties.AutomationId="DetailsTab"
                Text="Details"
                Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}" />
        </SelectorBar>

        <!-- General tab. -->
        <ScrollViewer
            x:Name="GeneralPage"
            Grid.Row="1"
            Padding="24,12,24,8"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Left"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="{x:Bind ViewModel.Icon, Mode=OneWay}" />
                    <TextBox
                        x:Name="NameBox"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Name"
                        BeforeTextChanging="NameBox_BeforeTextChanging"
                        Text="{x:Bind ViewModel.EditedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Border Style="{StaticResource DividerStyle}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Bind TypeLabel, Mode=OneTime}" />
                    <TextBlock
                        x:Name="TypeText"
                        AutomationProperties.Name="Type"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.Type, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource LabelStyle}"
                        Text="Opens with:"
                        Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}" />
                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        ColumnSpacing="8"
                        Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="16"
                            Height="16"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind ViewModel.OpensWithIcon, Mode=OneWay}" />
                        <TextBlock
                            x:Name="OpensWithText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Opens with"
                            Text="{x:Bind ViewModel.OpensWith, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="ChangeButton"
                            Grid.Column="2"
                            Click="ChangeButton_Click"
                            Content="Change..." />
                    </Grid>
                </Grid>

                <!-- A folder's Type is in the same group as its Location, as in File Explorer. -->
                <Border Style="{StaticResource DividerStyle}" Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Location:" />
                    <TextBlock
                        x:Name="LocationText"
                        AutomationProperties.Name="Location"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.Location, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource LabelStyle}"
                        Text="Size:" />
                    <TextBlock
                        x:Name="SizeText"
                        Grid.Row="1"
                        AutomationProperties.Name="Size"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.Size, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource LabelStyle}"
                        Text="Size on disk:" />
                    <TextBlock
                        x:Name="SizeOnDiskText"
                        Grid.Row="2"
                        AutomationProperties.Name="Size on disk"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.SizeOnDisk, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource LabelStyle}"
                        Text="Contains:"
                        Visibility="{x:Bind ViewModel.IsFolder, Mode=OneTime}" />
                    <TextBlock
                        x:Name="ContainsText"
                        Grid.Row="3"
                        AutomationProperties.Name="Contains"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.Contains, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsFolder, Mode=OneTime}" />
                </Grid>

                <Border Style="{StaticResource DividerStyle}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Created:" />
                    <TextBlock
                        x:Name="CreatedText"
                        AutomationProperties.Name="Created"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.Created, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource LabelStyle}"
                        Text="Modified:"
                        Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}" />
                    <TextBlock
                        x:Name="ModifiedText"
                        Grid.Row="1"
                        AutomationProperties.Name="Modified"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.Modified, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}" />
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource LabelStyle}"
                        Text="Accessed:"
                        Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}" />
                    <TextBlock
                        x:Name="AccessedText"
                        Grid.Row="2"
                        AutomationProperties.Name="Accessed"
                        Style="{StaticResource ValueStyle}"
                        Text="{x:Bind ViewModel.Accessed, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsFile, Mode=OneTime}" />
                </Grid>

                <Border Style="{StaticResource DividerStyle}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,6"
                        VerticalAlignment="Top"
                        Style="{StaticResource LabelStyle}"
                        Text="Attributes:" />
                    <StackPanel x:Name="AttributesPanel" Grid.Column="1">
                        <!-- For a folder, Read-only starts in the "■" state and applies to the files in it. -->
                        <CheckBox
                            x:Name="ReadOnlyCheck"
                            Content="{x:Bind ReadOnlyText, Mode=OneTime}"
                            IsChecked="{x:Bind ViewModel.IsReadOnly, Mode=TwoWay}"
                            IsThreeState="{x:Bind ViewModel.IsFolder, Mode=OneTime}" />
                        <CheckBox
                            x:Name="HiddenCheck"
                            Content="Hidden"
                            IsChecked="{x:Bind ViewModel.IsHidden, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Details tab. -->
        <Grid
            x:Name="DetailsPage"
            Grid.Row="1"
            Padding="12,12,12,8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,0,12,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Property" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Value" />
            </Grid>
            <ListView
                x:Name="DetailsList"
                Grid.Row="1"
                AutomationProperties.Name="Details"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                ItemsSource="{x:Bind ViewModel.Details, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:PropertyRow">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- A group heading such as "Description", over the whole row. -->
                            <TextBlock
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,2"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name, Mode=OneTime}"
                                Visibility="{x:Bind IsGroup, Mode=OneTime}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Name, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}"
                                Visibility="{x:Bind IsProperty, Mode=OneTime}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Value, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind IsProperty, Mode=OneTime}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Padding="24,12,24,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="OkButton"
                MinWidth="88"
                Click="OkButton_Click"
                Content="OK"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                MinWidth="88"
                Click="CancelButton_Click"
                Content="Cancel" />
            <Button
                x:Name="ApplyButton"
                MinWidth="88"
                Click="ApplyButton_Click"
                Content="Apply"
                IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
