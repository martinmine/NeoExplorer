<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NeoExplorer.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NeoExplorer.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="SidebarItemTemplate" x:DataType="vm:SidebarItem">
            <TreeViewItem AutomationProperties.Name="{x:Bind AccessibleName}" ItemsSource="{x:Bind Children, Mode=OneWay}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        AutomationProperties.AccessibilityView="Raw"
                        Width="16"
                        Height="16"
                        Source="{x:Bind Icon, Mode=OneWay}" />
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Glyph="{x:Bind Glyph}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE718;"
                        Visibility="{x:Bind IsPinned}" />
                </Grid>
            </TreeViewItem>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Padding="0,4">
            <TreeView
                x:Name="QuickAccessTree"
                AutomationProperties.Name="Quick access"
                CanDragItems="False"
                ItemInvoked="Tree_ItemInvoked"
                ItemTemplate="{StaticResource SidebarItemTemplate}"
                ItemsSource="{x:Bind ViewModel.QuickAccessItems, Mode=OneWay}" />

            <Rectangle
                Height="1"
                Margin="12,8"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TreeView
                x:Name="ThisPCTree"
                AutomationProperties.Name="This PC"
                CanDragItems="False"
                ItemInvoked="Tree_ItemInvoked"
                ItemTemplate="{StaticResource SidebarItemTemplate}"
                ItemsSource="{x:Bind ViewModel.ThisPCItems, Mode=OneTime}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
