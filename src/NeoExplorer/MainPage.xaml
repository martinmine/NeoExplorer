<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NeoExplorer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NeoExplorer.Views"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="EditPath_Invoked" />
        <KeyboardAccelerator Key="D" Modifiers="Menu" Invoked="EditPath_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="FocusSearch_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Navigation bar, drawn in the window's title bar area. -->
        <Grid
            Height="48"
            Padding="8,0,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="188" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    x:Name="BackButton"
                    AutomationProperties.Name="Back"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    ToolTipService.ToolTip="Back">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <Button
                    x:Name="ForwardButton"
                    AutomationProperties.Name="Forward"
                    Command="{x:Bind ViewModel.GoForwardCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    ToolTipService.ToolTip="Forward">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="&#xE72A;" />
                </Button>
                <Button
                    x:Name="UpButton"
                    AutomationProperties.Name="Up"
                    Command="{x:Bind ViewModel.GoUpCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    ToolTipService.ToolTip="Up">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="&#xE74A;" />
                </Button>
                <Button
                    x:Name="RefreshButton"
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource NavigationButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>

            <Border
                Grid.Column="1"
                Height="32"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid>
                    <!-- Clicking the empty space next to the breadcrumb switches to typing a path. -->
                    <Grid
                        x:Name="PathArea"
                        Padding="4,0"
                        Background="Transparent"
                        Tapped="PathArea_Tapped">
                        <BreadcrumbBar
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Address"
                            ItemClicked="Breadcrumb_ItemClicked"
                            ItemsSource="{x:Bind ViewModel.Segments, Mode=OneWay}" />
                    </Grid>

                    <TextBox
                        x:Name="PathTextBox"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Address"
                        BorderThickness="0"
                        KeyDown="PathTextBox_KeyDown"
                        LostFocus="PathTextBox_LostFocus"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search"
                IsEnabled="{x:Bind ViewModel.IsFolder, Mode=OneWay}"
                KeyDown="SearchBox_KeyDown"
                PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged"
                ToolTipService.ToolTip="Type to filter this folder. Press Enter to also search subfolders." />

            <!-- Drag area for moving the window; the system caption buttons are drawn on top of it. -->
            <Border
                x:Name="DragRegion"
                x:FieldModifier="internal"
                Grid.Column="3"
                Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:SidebarView x:Name="SidebarView" AutomationProperties.Name="Sidebar" />

            <Grid
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <views:ThisPcView x:Name="ThisPcView" Visibility="{x:Bind ViewModel.IsThisPC, Mode=OneWay}" />
                <views:FolderView x:Name="FolderView" Visibility="{x:Bind ViewModel.IsFolder, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
